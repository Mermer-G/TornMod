  "Configs": {
    "WeaponConfig": {
      "DisplayName": "Gameplay Settings",
      "InstantRespawn": {
        "Label": "Instant Respawn",
        "Tooltip": "Remove the respawn countdown. Hardcore deaths still remain permanent."
      },
      "Invincibility": {
        "Tooltip": "Prevent player damage while enabled.",
        "Label": "Invincibility"
      },
      "WarpToCursor": {
        "Label": "Warp to Cursor",
        "Tooltip": "Enable the Warp to Cursor key (R by default). Replaces Quick Mount on a warp press while enabled."
      }
    }
